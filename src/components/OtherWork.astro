---
import type { Locale } from '../i18n/locales';
import { OTHER } from '../data/projects';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<ul class="compact">
  {OTHER.map((p) => (
    <li>
      <a href={p.repo}>{p.id}</a>
      <p>
        {p.oneLiner[locale]}
        {p.verification[0] && <span class="mono muted"> · {p.verification[0].result[locale]}</span>}
      </p>
    </li>
  ))}
</ul>
