---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import { SKILLS } from '../data/skills';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<ul class="skills">
  {SKILLS.map((s) => (
    <li>
      <h3>
        {s.name[locale]}
        <span class="level">{s.level === 'used' ? t(locale, 'skill.level.used') : t(locale, 'skill.level.fundamentals')}</span>
      </h3>
      <p>{s.detail[locale]}</p>
      <ul class="links-inline" aria-label={`${s.name[locale]}: evidence`}>
        {s.evidence.map((e) => <li><a href={e.url}>{e.label}</a></li>)}
      </ul>
    </li>
  ))}
</ul>
