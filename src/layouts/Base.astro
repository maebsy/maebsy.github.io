---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, LOCALE_META, DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import { IS_PREVIEW, SITE } from '../data/site';
import { sectionHasContent } from '../lib/content';
import type { NavKey } from '../lib/nav';

interface Props {
  locale: Locale;
  title: string;
  description?: string | undefined;
  /** URL of this page in every locale; null = translation does not exist. */
  alternates: Record<Locale, string | null>;
  nav: NavKey;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | undefined;
  noindex?: boolean;
}

const {
  locale,
  title,
  description = t(locale, 'site.description'),
  alternates,
  nav,
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const self = alternates[locale] ?? Astro.url.pathname;
const canonical = new URL(self, SITE.url).href;
const fullTitle = nav === 'home' ? `${SITE.handle} | ${title}` : `${title} | ${SITE.handle}`;
const hreflangs = LOCALES.filter((l) => alternates[l] !== null).map((l) => ({
  lang: LOCALE_META[l].htmlLang,
  href: new URL(alternates[l] as string, SITE.url).href,
}));
const xDefault = alternates[DEFAULT_LOCALE];
const hasBlog = (await sectionHasContent('blog')) && !noindex;
const rssHref = locale === DEFAULT_LOCALE ? '/rss.xml' : `/${locale}/rss.xml`;
---
<!doctype html>
<html lang={LOCALE_META[locale].htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {hreflangs.length > 1 && hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    {hreflangs.length > 1 && xDefault && (
      <link rel="alternate" hreflang="x-default" href={new URL(xDefault, SITE.url).href} />
    )}
    {(noindex || IS_PREVIEW) && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15171a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.handle} />
    <meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {hasBlog && (
      <link rel="alternate" type="application/rss+xml" title={`${SITE.handle} (${LOCALE_META[locale].label})`} href={rssHref} />
    )}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var s = localStorage.getItem('theme');
          if (s === 'light' || s === 'dark') d.setAttribute('data-theme', s);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'skip')}</a>
    {IS_PREVIEW && (
      <div class="preview-banner" role="note"><div class="wrap">{t(locale, 'notice.preview')}</div></div>
    )}
    <Header locale={locale} alternates={alternates} nav={nav} />
    <main id="main" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer locale={locale} />
  </body>
</html>
